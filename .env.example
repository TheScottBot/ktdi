DISCORD_TOKEN=your-bot-token-here
# Prefix for text commands, e.g. "!" gives "!spray". /spray always works too.
COMMAND_PREFIX=!
# Optional but recommended: comma-separated server IDs, so slash command changes show up instantly.
# Slash commands only work in the servers listed here. (Developer Mode -> right-click the server icon -> Copy Server ID)
# GUILD_IDS=111111111111111111,222222222222222222
# Optional: Discord user ID that /linux pings. Defaults to our Linux hater.
# (Developer Mode -> right-click user -> Copy User ID)
# LINUX_HATER_ID=
# Optional: name of the role given to the server's biggest briber. Defaults to "Champion Briber".
# BRIBER_ROLE_NAME=Champion Briber
# Optional: rolling log file. Defaults to logs/ktdi.log (logs/ktdi-dev.log with --dev),
# rotating at 1 MB and keeping 5 old files.
# LOG_FILE=logs/ktdi.log
# LOG_MAX_BYTES=1000000
# LOG_BACKUPS=5
# Optional: where spray counts are stored. Defaults to ktdi.db next to bot.py.
# DB_PATH=/path/to/ktdi.db
