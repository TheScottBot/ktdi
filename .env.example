DISCORD_TOKEN=your-bot-token-here
# Prefix for text commands, e.g. "!" gives "!spray". /spray always works too.
COMMAND_PREFIX=!
# Optional but recommended: comma-separated server IDs, so slash command changes show up instantly.
# Slash commands only work in the servers listed here. (Developer Mode -> right-click the server icon -> Copy Server ID)
# GUILD_IDS=111111111111111111,222222222222222222
# Optional: Discord user ID that /linux pings. Defaults to @poltergeis.t.
# (Developer Mode -> right-click user -> Copy User ID)
# LINUX_HATER_ID=
# Discord user ID that /anime asks about a random anime. /anime says it isn't set up until this is set.
# ANIME_USER_ID=
# Who may choose the Don with /settings whospray_user (comma-separated user IDs). Nobody else can,
# not even server admins. Leave empty and nobody can change the Don.
# WHOSPRAY_ADMIN_IDS=
# Optional: Calibre-Web library for /books. Leave CALIBRE_URL unset to turn the feature off.
# Use a dedicated Calibre-Web account that only has download permission.
# /books only works (and only shows up) in the servers listed in BOOKS_GUILD_IDS.
# CALIBRE_URL=http://localhost:8083
# CALIBRE_USERNAME=discord-bot
# CALIBRE_PASSWORD=
# BOOKS_GUILD_IDS=111111111111111111,222222222222222222
# Format preference, best first. The first one that fits Discord's upload limit is sent.
# BOOK_FORMATS=epub,kepub,azw3,mobi,pdf,cbz
# Optional: the bot's own timezone (IANA name). /timezone convert falls back to it when someone leaves out a zone
# and hasn't set their own. Defaults to UK time.
# BOT_TIMEZONE=Europe/London
# Optional: timezone for /campaign remind times (IANA name). Defaults to BOT_TIMEZONE.
# REMINDER_TIMEZONE=Europe/London
# Optional: name of the role given to the server's biggest briber. Defaults to "Champion Briber".
# BRIBER_ROLE_NAME=Champion Briber
# Optional: rolling log file. Defaults to logs/ktdi.log (logs/ktdi-dev.log with --dev),
# rotating at 1 MB and keeping 5 old files.
# LOG_FILE=logs/ktdi.log
# LOG_MAX_BYTES=1000000
# LOG_BACKUPS=5
# Optional: where spray counts are stored. Defaults to ktdi.db next to bot.py.
# DB_PATH=/path/to/ktdi.db
